{
    "name": "Battlecard + PostgreSQL",
    "dockerComposeFile": "docker-compose.yml",
    "service": "battlecard",
    "workspaceFolder": "/workspace/battlecard",
    "customizations": {
        "vscode": {
            "extensions": [
                "Vue.volar",
                "ms-edgedevtools.vscode-edge-devtools",
                "Lokalise.i18n-ally"
            ]
        }
    },
    "postCreateCommand": {
        "server": "cd server && npm install",
        "client": "cd client && npm install"
    },
    "remoteEnv": {
        "BATTLECARD_dbHost": "postgres",
        "BATTLECARD_dbPort": "5432",
        "BATTLECARD_dbUser": "postgres",
        "BATTLECARD_dbPassword": "postgres",
        "BATTLECARD_dbName": "battlecard",
        "BATTLECARD_gotenbergUrl": "http://gotenberg:3000",
        "BATTLECARD_enableOpenApi": "true"
    }
}